<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER & CONNECTION -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#1565C0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SMART LAUNDRY SYSTEM"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hệ thống giàn phơi thông minh &amp; bảo vệ quần áo IoT"
                    android:textColor="#E3F2FD"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/tvConnectionStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="● Đang kiểm tra kết nối..."
                        android:textColor="#BBDEFB"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnConnectMqtt"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Kết nối lại"
                        android:textSize="11sp"
                        android:backgroundTint="#1976D2"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CẢNH BÁO MƯA (ẨN HIỆN ĐỘNG) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardRainWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#D32F2F">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌧️"
                    android:textSize="26sp"
                    android:layout_marginEnd="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CẢNH BÁO: TRỜI ĐANG MƯA!"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Giàn phơi đã tự động thu vào và kích hoạt sấy khô an toàn."
                        android:textColor="#FFEBEE"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- THÔNG SỐ CẢM BIẾN REALTIME -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DỮ LIỆU MÔI TRƯỜNG THỜI GIAN THỰC"
                    android:textColor="#37474F"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Nhiệt độ -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌡️ Nhiệt độ"
                            android:textColor="#78909C"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvTemperature"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- °C"
                            android:textColor="#E65100"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Độ ẩm -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💧 Độ ẩm"
                            android:textColor="#78909C"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvHumidity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- %"
                            android:textColor="#0277BD"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Cảm biến mưa -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌦️ Thời tiết"
                            android:textColor="#78909C"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvRainStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TẠNH RÁO"
                            android:textColor="#2E7D32"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvRainAnalog"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Analog: --"
                            android:textColor="#90A4AE"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#ECEFF1"
                    android:layout_marginVertical="12dp" />

                <!-- Trạng thái thiết bị -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Vị trí giàn:"
                        android:textColor="#546E7A"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvRackStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đã Thu Vào (An Toàn)"
                        android:textColor="#263238"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Quạt sấy hỗ trợ:"
                        android:textColor="#546E7A"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvFanStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TẮT"
                        android:textColor="#263238"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Chế độ vận hành:"
                        android:textColor="#546E7A"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvCurrentMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TỰ ĐỘNG (AUTO)"
                        android:textColor="#1565C0"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLastUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cập nhật: --:--:--"
                    android:textColor="#B0BEC5"
                    android:textSize="10sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- BẢNG ĐIỀU KHIỂN THIẾT BỊ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BẢNG ĐIỀU KHIỂN TỰ ĐỘNG &amp; THỦ CÔNG"
                    android:textColor="#37474F"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Chế độ Tự Động (Auto Mode)"
                        android:textColor="#263238"
                        android:textSize="14sp" />

                    <Switch
                        android:id="@+id/switchAutoMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="* Tự động thu giàn phơi khi mưa hoặc độ ẩm cao, mở đón nắng khi trời ráo."
                    android:textColor="#78909C"
                    android:textSize="11sp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnOpenRack"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="☀️ Mở Giàn Phơi"
                        android:backgroundTint="#2E7D32"
                        android:textColor="#FFFFFF"
                        android:enabled="false"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnCloseRack"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🏠 Thu Giàn Phơi"
                        android:backgroundTint="#C62828"
                        android:textColor="#FFFFFF"
                        android:enabled="false"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Quạt sấy hỗ trợ (Thủ công)"
                        android:textColor="#263238"
                        android:textSize="14sp" />

                    <Switch
                        android:id="@+id/switchFanControl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:enabled="false" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TRỢ LÝ GIẶT SẤY AI GEMINI -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖 TRỢ LÝ GIẶT SẤY AI (GEMINI POWERED)"
                    android:textColor="#6A1B9A"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tư vấn thời gian khô quần áo, mẹo chăm sóc vải theo cảm biến thực tế"
                    android:textColor="#78909C"
                    android:textSize="11sp"
                    android:layout_marginBottom="10dp" />

                <!-- Khung Chat Log -->
                <ScrollView
                    android:id="@+id/chatScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:background="#F5F5F5"
                    android:padding="8dp">

                    <LinearLayout
                        android:id="@+id/chatMessagesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

                <TextView
                    android:id="@+id/tvAIStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI đang xử lý..."
                    android:textColor="#AB47BC"
                    android:textSize="11sp"
                    android:visibility="gone"
                    android:layout_marginTop="4dp" />

                <!-- Nút câu hỏi nhanh -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnQuickDryingTime"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="⏱️ Bao lâu thì khô?"
                            android:textSize="10sp"
                            android:backgroundTint="#EDE7F6"
                            android:textColor="#4A148C"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnQuickSilkTips"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="🧣 Mẹo phơi đồ len &amp; lụa"
                            android:textSize="10sp"
                            android:backgroundTint="#EDE7F6"
                            android:textColor="#4A148C"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnQuickRainCheck"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="🌦️ Có nên phơi bây giờ?"
                            android:textSize="10sp"
                            android:backgroundTint="#EDE7F6"
                            android:textColor="#4A148C" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Input Chat -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/etAIQuestion"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="#EEEEEE"
                        android:hint="Hỏi AI cách phơi đồ, mẹo giặt sấy..."
                        android:paddingHorizontal="12dp"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btnAskAI"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:backgroundTint="#7B1FA2"
                        android:src="@android:drawable/ic_menu_send"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
